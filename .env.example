# Optional but recommended: enables AI-written DESIGN.md prose, screenshot mode and code recreation.
# Any OpenAI-compatible API works (OpenAI, OpenRouter, Groq...) via OPENAI_BASE_URL.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini        # prose
# OPENAI_CODE_MODEL=gpt-4.1        # screenshots + code recreation (needs vision)

# Optional: path to a local Chrome/Chromium. Auto-detected on most machines.
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Per-IP limits (per hour)
# RATE_LIMIT_PER_HOUR=30
# RECREATE_LIMIT_PER_HOUR=10
